{
  "name": "@irithell-js/better-sqlite3-termux",
  "version": "1.0.13",
  "description": "Better-SQLite3 wrapper for Termux",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "types.d.cts"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./types.d.cts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./types.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./types.d.cts",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "jest",
    "postinstall": "node ./dist/install.cjs",
    "prepublishOnly": "npm run build"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.9.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.9",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "sqlite3",
    "better-sqlite3",
    "termux",
    "android",
    "bot",
    "database"
  ],
  "author": "Irithell",
  "engines": {
    "node": ">=18.0.0"
  }
}