import Database from "better-sqlite3";

export interface EngineInfo {
  projectId: string;
  enginePath: string;
  originalProjectDir?: string;
  installedAt?: string;
  moduleVersion?: string;
  requestedVersion?: string;
  environment?: string;
  exists: boolean;
}

export function listEngines(): EngineInfo[];
export function getCurrentEngine(): EngineInfo | null;
export function deleteEngine(projectId?: string): boolean;
export function clearAllEngines(): boolean;

export const engineManager: {
  list: typeof listEngines;
  current: typeof getCurrentEngine;
  delete: typeof deleteEngine;
  clearAll: typeof clearAllEngines;
};

export = Database;
